# Copy to .env.local and fill in. Validated at startup by src/lib/env.ts.

# Gemini API key — https://aistudio.google.com/apikey
# Optional: without it, audits are deterministic-only and labelled "AI unavailable".
GEMINI_API_KEY=

# Vision model (verified via ListModels). Fallbacks (comma-separated, max 2) are tried
# in order if the primary fails — each retry uses a different model.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash
GEMINI_TIMEOUT_MS=30000

# MongoDB connection string. REQUIRED in production.
# Leave empty in development to use the volatile in-memory store.
MONGODB_URI=

# Set to true to knowingly run production without MongoDB (data lost on restart).
ALLOW_MEMORY_DB=false

# Audit creations allowed per client IP per window.
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=600000
